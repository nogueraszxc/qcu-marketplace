# Configure these in the Vercel Production environment, then rebuild.
API_INTERNAL_ORIGIN=https://YOUR-API.onrender.com
BACKEND_PROXY_KEY=
NEXT_PUBLIC_QCU_ASSETS_AUTHORIZED=false
