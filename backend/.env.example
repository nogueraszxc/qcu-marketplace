NODE_ENV=development
HOST=127.0.0.1
PORT=5000
APP_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
# npm run dev:local supplies an isolated persistent local replica-set URI.
# For npm start, explicitly configure your own replica set:
MONGO_URI=mongodb://127.0.0.1:27018/qcu_marketplace_local?replicaSet=qcu-local
PUBLIC_LAUNCH_ENABLED=false
QCU_AUTHORIZED=false
QCU_BRANDING_ENABLED=false
BACKEND_PROXY_KEY=
OPERATOR_NAME=Chandler Noguera
OPERATOR_EMAIL=noguera.chandler.espenilla@gmail.com
OPERATOR_ADDRESS=
REQUIRED_EMAIL_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
# No JWT_SECRET is used. No default administrator credentials are provided.
